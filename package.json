{
  "name": "catalog-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @catalog/web",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @catalog/web",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  }
}
